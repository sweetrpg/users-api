                    {
                        "description": "Target user identifier",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/server.sendFriendRequestRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
